# Copy this file to src/backend/.env for local backend configuration.
# Account features require MongoDB and a long random JWT secret.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/voltra
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Optional Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Optional server-side fallback for the household energy assistant
GROQ_API_KEY=
GROQ_USAGE_MODEL=openai/gpt-oss-120b
